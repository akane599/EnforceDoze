<!-- Debug builds only: the adb command receiver for the emulator gates (SPEC 13.2, 13.3). DUMP keeps
     every caller but the shell and the system out. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="io.github.akane599.enforcedoze.app.DebugCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
