<resources>
    <!-- The window behind the Compose UI (ADR 0037): a platform theme, so no upstream Material or preference
         library is needed. Its background is the palette's ground, so a cold start shows no other colour
         (DESIGN.md; ThemeTest checks the value against Palette). Edge-to-edge and the bar icons are set by
         enableEdgeToEdge in MainActivity. -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_ground</item>
    </style>
</resources>
