<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Coulomb reads the evidence provider and opens a report with it (SPEC 11.3, ADR 0035). Signature: both apps are
         signed with the build server's key; the provider also checks that the caller is Coulomb. -->
    <permission
        android:name="io.github.akane599.enforcedoze.permission.READ_EVIDENCE"
        android:protectionLevel="signature" />

    <!-- Permission audit (ADR 0037): each permission is declared by the module that uses it. The modules add
         ACCESS_WIFI_STATE and ACCESS_NETWORK_STATE (:core:doze-android: the hotspot hold-off and the root-tier
         extras' reads) and DUMP, WRITE_SECURE_SETTINGS, READ_LOGS and PACKAGE_USAGE_STATS (:core:privilege: the
         T1 grants). Upstream's WAKE_LOCK, CHANGE_WIFI_STATE, READ_PHONE_STATE and WRITE_SETTINGS are gone:
         nothing holds a wake lock, Wi-Fi and data go through the worker, calls are read from the audio mode. -->
    <!-- The engine starts at boot and after its own update (EngineStartReceiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- EngineService, a special-use foreground service that watches the screen (SPEC 5). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        android:minSdkVersion="34" />
    <!-- The engine's notification, the night report and the stuck-extra notice. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The capabilities step asks for the exemption through the system dialog (SPEC 3.3, ADR 0034). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- The app pickers (allowlist, keep-awake, suspension) list every app. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- The Shizuku permission (API_V23) is declared by :core:privilege. -->

    <!-- No backup and no device-to-device transfer (ADR 0039): stock.json and previous.json belong to this phone, and
         restoring them on another would make Restore stock write this phone's values there; the automation tokens
         stay with the phone they were made on. -->
    <application
        android:name="io.github.akane599.enforcedoze.app.EnforceDozeApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- Lets the macrobenchmark profile the release build (SPEC 10.5 optimize); reveals nothing to other apps. -->
        <profileable android:shell="true" />
        <!-- The fork's Compose app is the launcher (ADR 0029). -->
        <activity android:name="io.github.akane599.enforcedoze.app.ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A tile's long press (SPEC 9.2): the tile's component names the screen to open. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>
        <!-- No upstream component is registered (ADR 0036). Upstream's exported receivers took commands from any app:
             ADD/REMOVE_WHITELIST pasted an extra into a shell command run as this app, ENABLE_FORCEDOZE started a
             second Doze manager, CHANGE_SETTING rewrote its settings. The classes stay until SPEC 12.1 deletes them. -->
        <!-- The engine (SPEC 12.4, ADR 0015). specialUse: no other type covers applying the owner's Doze
             profile at screen off and on; it reacts to broadcasts only and runs no work in between. -->
        <service
            android:name="io.github.akane599.enforcedoze.app.EngineService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Applies the owner's Doze profile at screen off and on and records whether Doze held" />
        </service>
        <receiver
            android:name="io.github.akane599.enforcedoze.app.EngineStartReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- SPEC 9.2, 11.2: the "Doze plan" and "Sensors off" tiles replace upstream's Doze and airplane tiles. -->
        <service
            android:name="io.github.akane599.enforcedoze.app.PlanTileService"
            android:icon="@drawable/ic_tile_plan"
            android:label="@string/tile_plan"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
        <service
            android:name="io.github.akane599.enforcedoze.app.SensorsTileService"
            android:icon="@drawable/ic_tile_sensors"
            android:label="@string/tile_sensors"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
        <!-- The Shizuku provider is declared by :core:privilege. -->
        <!-- Evidence exports (SPEC 8.7) go to the share sheet through this provider; nothing is uploaded. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/export_paths" />
        </provider>
        <provider
            android:name="io.github.akane599.enforcedoze.app.evidence.EvidenceProvider"
            android:authorities="io.github.akane599.enforcedoze.evidence"
            android:exported="true"
            android:permission="io.github.akane599.enforcedoze.permission.READ_EVIDENCE" />
        <!-- The report link for Coulomb (ADR 0035): a stable action and extra, not the activity's class or its own extras. -->
        <activity-alias
            android:name="io.github.akane599.enforcedoze.EvidenceReport"
            android:exported="true"
            android:permission="io.github.akane599.enforcedoze.permission.READ_EVIDENCE"
            android:targetActivity="io.github.akane599.enforcedoze.app.ui.MainActivity">
            <intent-filter>
                <action android:name="io.github.akane599.enforcedoze.action.OPEN_REPORT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
        <!-- The automation API (SPEC 11.1): exported with no permission, each call checked by a client's token; disabled
             until the owner turns the API on (ADR 0033). -->
        <receiver
            android:name="io.github.akane599.enforcedoze.app.automation.AutomationReceiver"
            android:enabled="false"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="io.github.akane599.enforcedoze.action.APPLY_PROFILE" />
                <action android:name="io.github.akane599.enforcedoze.action.APPLY_PLAN" />
                <action android:name="io.github.akane599.enforcedoze.action.PAUSE" />
                <action android:name="io.github.akane599.enforcedoze.action.RESUME" />
                <action android:name="io.github.akane599.enforcedoze.action.RESTORE_STOCK" />
                <action android:name="io.github.akane599.enforcedoze.action.SENSORS_OFF" />
                <action android:name="io.github.akane599.enforcedoze.action.GET_STATUS" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
