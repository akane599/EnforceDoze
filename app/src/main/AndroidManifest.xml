<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Coulomb reads the evidence provider and opens a report with it (SPEC 11.3, ADR 0035). Signature: both apps are
         signed with the build server's key; the provider also checks that the caller is Coulomb. -->
    <permission
        android:name="io.github.akane599.enforcedoze.permission.READ_EVIDENCE"
        android:protectionLevel="signature" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
<!--    <uses-permission android:name="android.permission.MANAGE_SENSOR_PRIVACY"-->
<!--        tools:ignore="ProtectedPermissions" />-->
    <uses-permission android:name="android.permission.READ_LOGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission
        android:name="android.permission.DUMP"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Usage access (SPEC 4.1 T0/T1): lists the app under Settings > Usage access and backs the
         GET_USAGE_STATS appop that usage events and batterystats need. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        android:minSdkVersion="34" />
    <!-- The Shizuku permission (API_V23) is declared by :core:privilege. -->

    <application
        android:name="com.akylas.enforcedoze.MyApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- Lets the macrobenchmark profile the release build (SPEC 10.5 optimize); reveals nothing to other apps. -->
        <profileable android:shell="true" />
        <!-- The fork's Compose app is the launcher (ADR 0029). -->
        <activity android:name="io.github.akane599.enforcedoze.app.ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A tile's long press (SPEC 9.2): the tile's component names the screen to open. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <!-- Upstream's screen: no entry point since the tiles were replaced; removed with the upstream code (SPEC 12.1). -->
        <activity android:name="com.akylas.enforcedoze.MainActivity"
            android:exported="false" />
        <receiver android:name="com.akylas.enforcedoze.BootCompleteReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <receiver android:name="com.akylas.enforcedoze.AutoRestartOnUpdate"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_REPLACED" />

                <data android:scheme="package" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.akylas.enforcedoze.EnableForceDozeService"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.akylas.enforcedoze.ENABLE_FORCEDOZE" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.akylas.enforcedoze.DisableForceDozeService"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.akylas.enforcedoze.DISABLE_FORCEDOZE" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.akylas.enforcedoze.AddWhiteListReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.akylas.enforcedoze.ADD_WHITELIST" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.akylas.enforcedoze.RemoveWhiteListReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.akylas.enforcedoze.REMOVE_WHITELIST" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.akylas.enforcedoze.SettingsChangeReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.akylas.enforcedoze.CHANGE_SETTING" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.akylas.enforcedoze.ReenterDoze"
            android:enabled="true"
            android:exported="true" />
        <receiver
            android:name="com.akylas.enforcedoze.CustomDozePeriodReceiver"
            android:enabled="true"
            android:exported="false" />
        <!-- The engine (SPEC 12.4, ADR 0015). specialUse: no other type covers applying the owner's Doze
             profile at screen off and on; it reacts to broadcasts only and runs no work in between. -->
        <service
            android:name="io.github.akane599.enforcedoze.app.EngineService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Applies the owner's Doze profile at screen off and on and records whether Doze held" />
        </service>
        <receiver
            android:name="io.github.akane599.enforcedoze.app.EngineStartReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service
            android:name="com.akylas.enforcedoze.ForceDozeService"
            android:enabled="true"
            android:exported="false" android:foregroundServiceType="specialUse"/>
        <!-- SPEC 9.2, 11.2: the "Doze plan" and "Sensors off" tiles replace upstream's Doze and airplane tiles. -->
        <service
            android:name="io.github.akane599.enforcedoze.app.PlanTileService"
            android:icon="@drawable/ic_tile_plan"
            android:label="@string/tile_plan"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
        <service
            android:name="io.github.akane599.enforcedoze.app.SensorsTileService"
            android:icon="@drawable/ic_tile_sensors"
            android:label="@string/tile_sensors"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
        <service
            android:name="com.akylas.enforcedoze.NotificationService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <activity
            android:name="com.akylas.enforcedoze.DozeStatsActivity"
            android:label="Doze battery stats (old)" />
        <activity
            android:name="com.akylas.enforcedoze.DozeBatteryStatsActivity"
            android:label="Doze battery stats" />
        <activity
            android:name="com.akylas.enforcedoze.WhitelistAppsActivity"
            android:label="Whitelist" />
        <activity
            android:name="com.akylas.enforcedoze.BlockNotificationsActivity"
            android:label="Doze Notifications blocklist" />
        <activity
            android:name="com.akylas.enforcedoze.BlockAppsActivity"
            android:label="Doze App blocklist" />
        <activity
            android:name="com.akylas.enforcedoze.SettingsActivity"
            android:label="Settings" />
        <activity
            android:name="com.akylas.enforcedoze.LogActivity"
            android:label="Debug log" />
        <activity
            android:name="com.akylas.enforcedoze.PackageChooserActivity"
            android:label="Package chooser" />
        <activity
            android:name="com.akylas.enforcedoze.AboutAppActivity"
            android:label="About" />
        <activity
            android:name="com.akylas.enforcedoze.TaskerBroadcastsActivity"
            android:label="Tasker broadcasts" />
        <activity
            android:name="com.akylas.enforcedoze.DozeTunablesActivity"
            android:label="Doze Tunables" />
        <activity android:name="com.akylas.enforcedoze.RequestIgnoreBatteryActivity"
            android:exported="false"
            android:theme="@style/Transparent.NoTitleBar" />
        <!-- The Shizuku provider is declared by :core:privilege. -->
        <!-- Evidence exports (SPEC 8.7) go to the share sheet through this provider; nothing is uploaded. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/export_paths" />
        </provider>
            <provider
            android:name="io.github.akane599.enforcedoze.app.evidence.EvidenceProvider"
            android:authorities="io.github.akane599.enforcedoze.evidence"
            android:exported="true"
            android:permission="io.github.akane599.enforcedoze.permission.READ_EVIDENCE" />
        <!-- The report link for Coulomb (ADR 0035): a stable action and extra, not the activity's class or its own extras. -->
        <activity-alias
            android:name="io.github.akane599.enforcedoze.EvidenceReport"
            android:exported="true"
            android:permission="io.github.akane599.enforcedoze.permission.READ_EVIDENCE"
            android:targetActivity="io.github.akane599.enforcedoze.app.ui.MainActivity">
            <intent-filter>
                <action android:name="io.github.akane599.enforcedoze.action.OPEN_REPORT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
        <!-- The automation API (SPEC 11.1): exported with no permission, each call checked by a client's token; disabled
             until the owner turns the API on (ADR 0033). -->
        <receiver
            android:name="io.github.akane599.enforcedoze.app.automation.AutomationReceiver"
            android:enabled="false"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="io.github.akane599.enforcedoze.action.APPLY_PROFILE" />
                <action android:name="io.github.akane599.enforcedoze.action.APPLY_PLAN" />
                <action android:name="io.github.akane599.enforcedoze.action.PAUSE" />
                <action android:name="io.github.akane599.enforcedoze.action.RESUME" />
                <action android:name="io.github.akane599.enforcedoze.action.RESTORE_STOCK" />
                <action android:name="io.github.akane599.enforcedoze.action.SENSORS_OFF" />
                <action android:name="io.github.akane599.enforcedoze.action.GET_STATUS" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
